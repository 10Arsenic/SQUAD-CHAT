# Copy this file to `.env` and fill in ONE key. `.env` is git-ignored.

# Which AI runs the squad: gemini (has a free tier) or anthropic (paid, Claude).
LLM_PROVIDER=gemini

# ---- Gemini (free tier) -------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Model the squad talks with, and the small model that extracts memories.
GEMINI_CHAT_MODEL=gemini-4-hydrogen
GEMINI_LORE_MODEL=gemini-3.5-flash-lite

# How hard the model thinks before replying: low | medium | high.
# Low keeps replies fast. Leave blank to use each model's default.
GEMINI_THINKING_LEVEL=low

# ---- Claude (paid) ------------------------------------------------------
# Only needed if LLM_PROVIDER=anthropic. Key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# claude-haiku-5-5 is the cheapest. claude-sonnet-5-5 and claude-opus-5-5 are
# better in character and cost more.
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
ANTHROPIC_LORE_MODEL=claude-haiku-5-5

# Reasoning effort for chat replies: low | medium | high.
ANTHROPIC_EFFORT=low

# ---- Chat behaviour -----------------------------------------------------
# What the squad calls you.
USER_NAME=You

# How many recent messages each character sees.
HISTORY_LIMIT=40

# How many random Lore Vault memories are slipped into each reply.
LORE_INJECT_COUNT=3

# Minimum / maximum seconds a character "types" before their bubble appears.
TYPING_DELAY_MIN=1.0
TYPING_DELAY_MAX=2.0

# Where the SQLite file lives (relative to the project root).
DATABASE_PATH=data/squad_room.db
